function mergeLines(oldStr,arr){
  const o=lines(oldStr), n=Array.isArray(arr)?arr.filter(Boolean).map(String):[];
  const seen=new Set(o.map(x=>x.trim().toLowerCase()));
  n.forEach(x=>{ const k=x.trim().toLowerCase(); if(k&&!seen.has(k)){ o.push(x.trim()); seen.add(k); } });
  return o.join('\n');
}
function applyAiUpdate(){
  const p=people.find(x=>x.id===aiUpdateId); if(!p){ toast('Карточка не найдена'); return; }
  let raw=(document.getElementById('aiUpdJson').value||'').trim();
  if(!raw){ toast('Вставь ответ от ИИ'); return; }
  raw=raw.replace(/^```(?:json)?/i,'').replace(/```$/,'').trim();
  const i=raw.indexOf('{'), j=raw.lastIndexOf('}');
  if(i>=0&&j>i) raw=raw.slice(i,j+1);
  let d; try{ d=JSON.parse(raw); }catch(e){ toast('Не похоже на JSON'); return; }
  // снимок до обновления
  const prevOvr=ovrFor(p,p.roleId), prevRole=p.roleId;
  if(!Array.isArray(p.history)) p.history=[];
  const arr=x=>Array.isArray(x)?x.filter(Boolean).map(String):[];
  const cl=x=>{ const n=parseInt(x,10); return isNaN(n)?'':String(Math.max(1,Math.min(99,n))); };
  // атрибуты
  if(d.attrs) ATTRS.forEach(a=>{ const v=cl(d.attrs[a.k]); if(v!=='') p.attrs[a.k]=v; });
  // простые поля — только если пришли непустыми
  ['metric','values','abilities','skills','notes'].forEach(k=>{ if(d[k]&&String(d[k]).trim()) p[k]=String(d[k]).trim(); });
  if(d.roleId&&ROLES.some(r=>r.id===d.roleId)) p.roleId=d.roleId;
  if(d.status&&STATUSES.some(x=>x.id===d.status)) p.status=d.status;
  if(d.vTag) ['values','abilities','skills'].forEach(k=>{ if(d.vTag[k]) p.vTag[k]=d.vTag[k]; });
  // списки-замены
  if(arr(d.fitGood).length) p.fitGood=arr(d.fitGood).join('\n');
  if(arr(d.fitBad).length) p.fitBad=arr(d.fitBad).join('\n');
  if(arr(d.watch).length) p.watch=arr(d.watch).join('\n');
  if(arr(d.gaps).length) p.gaps=arr(d.gaps).join('\n');
  // списки-дополнения
  p.track=mergeLines(p.track,arr(d.track));
  p.conflicts=mergeLines(p.conflicts,arr(d.conflicts));
  // доверие: по области
  if(Array.isArray(d.bel)) d.bel.filter(b=>b&&b.area).forEach(b=>{
    const key=String(b.area).trim().toLowerCase();
    const ex=(p.bel||[]).find(x=>String(x.area).trim().toLowerCase()===key);
    const lv=Math.max(0,Math.min(5,parseInt(b.lv,10)||0));
    if(ex) ex.lv=lv; else (p.bel=p.bel||[]).push({area:String(b.area).trim(), lv});
  });
  // история
  const newOvr=ovrFor(p,p.roleId);
  p.history.push({ t:Date.now(), from:prevOvr, to:newOvr, role:p.roleId, roleFrom:prevRole,
                   why:String(d.changed||'').trim() });
  saveArr(K_PEOPLE,people);
  document.getElementById('aiPanel').innerHTML=''; aiUpdateId=null;
  renderPeople(); renderVoters();
  const delta=newOvr-prevOvr;
  toast(delta===0?'Карточка обновлена':('Рейтинг '+prevOvr+' → '+newOvr+' ('+(delta>0?'+':'')+delta+')'));
  setTimeout(()=>openPersonDetail(p.id),260);
}
function historyBlock(p){
