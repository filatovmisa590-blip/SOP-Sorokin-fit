  toast('Сформулируй принцип из этого разбора');
}
function toggleFav(id){ const p=principles.find(x=>x.id===id); if(!p)return; p.fav=!p.fav; saveArr(K_PRIN,principles); renderPrinciples(); }
function downloadText(name,text){ try{ const b=new Blob([text],{type:'text/plain;charset=utf-8'}); const u=URL.createObjectURL(b); const a=document.createElement('a'); a.href=u; a.download=name; document.body.appendChild(a); a.click(); document.body.removeChild(a); setTimeout(()=>URL.revokeObjectURL(u),1000); }catch(e){ copyText(text); } }
function exportPrinciplesDoc(){
  if(!principles.length){ toast('Принципов пока нет'); return; }
  const byCat={}; principles.forEach(p=>{ (byCat[p.category]=byCat[p.category]||[]).push(p); });
  const L=['МОИ ПРИНЦИПЫ', new Date().toLocaleDateString('ru-RU'), ''];
  CATS.forEach(c=>{ const a=byCat[c.id]; if(!a||!a.length)return; L.push('## '+c.label.toUpperCase()); a.forEach(p=>{ L.push('• '+(p.trigger?('Когда '+p.trigger+' → '):'')+p.rule); if(p.why) L.push('   ('+p.why+')'); }); L.push(''); });
  downloadText('moi-principy.txt', L.join('\n')); toast('Документ скачан');
}
function exportAll(){
  const data={ app:'principles-dalio', version:3, exportedAt:Date.now(), principles, people, machines, decisions, trash };
  try{ const b=new Blob([JSON.stringify(data,null,2)],{type:'application/json'}); const u=URL.createObjectURL(b); const a=document.createElement('a'); a.href=u; a.download='principles-backup-'+new Date().toISOString().slice(0,10)+'.json'; document.body.appendChild(a); a.click(); document.body.removeChild(a); setTimeout(()=>URL.revokeObjectURL(u),1000); toast('Резервная копия скачана'); }catch(e){ toast('Не удалось скачать'); }
}
function importAll(input){
  const f=input.files&&input.files[0]; if(!f){ return; }
  const r=new FileReader();
  r.onload=function(){ try{ const d=JSON.parse(r.result);
      if(!confirm('Импортировать данные из файла? Текущие принципы, люди, разборы и решения будут заменены.')){ input.value=''; return; }
      if(Array.isArray(d.principles)) principles=d.principles;
      if(Array.isArray(d.people)) people=d.people.map(migratePerson);
      if(Array.isArray(d.machines)) machines=d.machines;
      if(Array.isArray(d.decisions)) decisions=d.decisions;
      if(Array.isArray(d.trash)) { trash=d.trash; saveArr(K_TRASH,trash); }
      saveArr(K_PRIN,principles); saveArr(K_PEOPLE,people); saveArr(K_MACH,machines); saveArr(K_DEC,decisions);
      renderDashboard(); toast('Данные импортированы');
    }catch(e){ toast('Не удалось прочитать файл'); }
    input.value='';
  };
  r.readAsText(f);
}
function switchTab(name){
  if(document.getElementById('panel-machine').classList.contains('active')) pullMachine();
  if(document.getElementById('panel-decision').classList.contains('active')) pullDec();
  document.querySelectorAll('.tab').forEach((t,i)=>{ const ns=['overview','principles','machine','people','decision']; t.classList.toggle('active',ns[i]===name); });
  document.querySelectorAll('.panel').forEach(p=>p.classList.remove('active'));
  document.getElementById('panel-'+name).classList.add('active');
  if(name==='overview') renderDashboard();
  else if(name==='principles') renderPrinciples();
  else if(name==='machine') populateMachine();
  else if(name==='people') renderPeople();
  else if(name==='decision') populateDec();
}
document.addEventListener('input', e=>{ if(e.target&&e.target.closest&&e.target.closest('#panel-machine')) pullMachine(); });
(function init(){
  if(!LS.get(K_SEED)){ if(!principles.length){ principles=SEED.slice(); saveArr(K_PRIN,principles); } LS.set(K_SEED,'1'); }
  saveArr(K_PEOPLE,people);
  const d=LS.get(K_MACH_CUR); if(d){ try{ curMachine=Object.assign(freshMachine(),JSON.parse(d)); }catch(e){ curMachine=freshMachine(); } }
  const dd=LS.get(K_DEC_CUR); if(dd){ try{ curDecision=Object.assign(freshDecision(),JSON.parse(dd)); if(!Array.isArray(curDecision.voters)) curDecision.voters=[]; }catch(e){ curDecision=freshDecision(); } }
  renderDashboard();
})();
</script>
</body>
