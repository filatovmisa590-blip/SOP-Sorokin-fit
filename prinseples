function vasBlock(p){
  if(!p.values&&!p.abilities&&!p.skills) return '';
  const tg=t=>t==='ok'?'<span class="vtag ok">подтверждено</span>':(t==='no'?'<span class="vtag no">не проверено</span>':(t==='q'?'<span class="vtag q">под вопросом</span>':''));
  const row=(l,txt,tag)=>`<div class="vas-row"><div class="vas-l">${l}</div><div class="vas-t ${txt?'':'empty'}">${txt?esc(txt):'—'}${txt?tg(tag):''}</div></div>`;
  return `<div class="pc-block"><div class="pc-h">Ценности · Способности · Навыки</div><div class="vas">
    ${row('Ценности',p.values,p.vTag&&p.vTag.values)}${row('Способности',p.abilities,p.vTag&&p.vTag.abilities)}${row('Навыки',p.skills,p.vTag&&p.vTag.skills)}
  </div></div>`;
}
function fitBlock(p){
  if(!p.fitGood&&!p.fitBad) return '';
