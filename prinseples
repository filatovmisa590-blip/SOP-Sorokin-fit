    <div class="fit-box g"><div class="fh">Играет сильно</div>${ul(p.fitGood)}</div>
    <div class="fit-box b"><div class="fh">Ломается</div>${ul(p.fitBad)}</div></div></div>`;
}
function belBlock(p){
  if(!Array.isArray(p.bel)||!p.bel.length) return '';
  const rows=p.bel.map(b=>{ const lv=+b.lv||0;
    const dots=[1,2,3,4,5].map(i=>`<i class="${i<=lv?'on'+(lv>=4?' hi':''):''}"></i>`).join('');
    return `<div class="bel-row"><div class="bel-a">${esc(b.area)}</div><div class="bel-lv"><span class="bel-txt">${BEL_LABEL[lv]||'нет данных'}</span><div class="dots">${dots}</div></div></div>`; }).join('');
  return `<div class="pc-block"><div class="pc-h">Доверие по вопросам</div><div class="bel-list">${rows}</div></div>`;
}
function trackBlock(p){
