.toast{ position:fixed; left:50%; bottom:32px; transform:translateX(-50%) translateY(24px); background:var(--ink);
  color:#fff; font-family:'IBM Plex Mono',monospace; font-size:12px; letter-spacing:.05em; padding:14px 26px;
  border-radius:12px; box-shadow:var(--sh-lg); opacity:0; pointer-events:none; transition:all .3s var(--ez); z-index:2000; }
