/* ── ЛЮДИ: модель ── */
const ATTRS=[
  {k:'nap', nm:'Напор',        sub:'доводит до решения'},
  {k:'kom', nm:'Коммуникация', sub:'располагает, влияет'},
  {k:'sis', nm:'Системность',  sub:'регламент, детали'},
  {k:'vyn', nm:'Выносливость', sub:'рутина, дистанция'},
  {k:'obu', nm:'Обучаемость',  sub:'меняется после ОС'},
  {k:'avt', nm:'Автономность', sub:'работает без надзора'}
];
const ROLES=[
  {id:'specialist', nm:'Специалист · ведение', pos:'СПЕЦ', w:{vyn:25,sis:25,obu:15,kom:15,avt:15,nap:5}},
  {id:'diagnost',   nm:'Диагност · продажи',   pos:'ДИАГ', w:{nap:30,kom:30,obu:15,avt:10,vyn:10,sis:5}},
  {id:'coordinator',nm:'Координатор · заявки', pos:'КООР', w:{kom:25,sis:25,vyn:20,nap:15,obu:10,avt:5}},
  {id:'manager',    nm:'Руководитель',         pos:'РУК',  w:{avt:25,nap:20,sis:20,kom:20,obu:10,vyn:5}},
  {id:'universal',  nm:'Универсал',            pos:'УНИВ', w:{nap:17,kom:17,sis:17,vyn:17,obu:16,avt:16}}
];
function roleOf(id){ return ROLES.find(r=>r.id===id)||ROLES[4]; }
function ovrFor(p,roleId){
  const w=roleOf(roleId).w; let sum=0,tot=0;
  ATTRS.forEach(a=>{ const v=parseInt(p.attrs&&p.attrs[a.k],10); if(!isNaN(v)){ sum+=v*w[a.k]; tot+=w[a.k]; } });
  return tot?Math.round(sum/tot):0;
}
function hasAttrs(p){ return ATTRS.some(a=>{ const v=parseInt(p.attrs&&p.attrs[a.k],10); return !isNaN(v); }); }
function bestPos(p){
  if(!hasAttrs(p)) return null;
  let best=null; ROLES.forEach(r=>{ if(r.id==='universal')return; const o=ovrFor(p,r.id); if(!best||o>best.ovr) best={role:r,ovr:o}; });
  return best;
}
function confOf(p){
  if(!hasAttrs(p)) return 0;
  var s2=0;
  s2 += Math.min(40, lines(p.track).length*5);
  var b=Array.isArray(p.bel)?p.bel:[];
  if(b.length){ var c=b.filter(function(x){return (+x.lv||0)>0;}).length; s2 += Math.round(c/b.length*25); }
  var vt=p.vTag||{};
  ['values','abilities','skills'].forEach(function(k){ if(vt[k]==='ok') s2+=10; else if(vt[k]==='q') s2+=4; });
  s2 -= lines(p.gaps).length*4;
  return Math.max(0,Math.min(100,s2));
}
function confLabel(c){
  if(c<35) return 'мало данных — рейтинг пока гипотеза';
  if(c<65) return 'проверено наполовину — рейтинг предварительный';
  return 'данных достаточно — рейтингу можно верить';
}
function tierOf(o){ return o>=88?'icon':(o>=78?'gold':(o>=66?'silver':'bronze')); }
function migratePerson(p){
  if(!p.attrs){
    p.attrs={nap:'',kom:'',sis:'',vyn:'',obu:'',avt:''};
    if(p.disc){ // старые DISC → атрибуты
      const d=parseInt(p.disc.d,10), i=parseInt(p.disc.i,10), st=parseInt(p.disc.s,10), c=parseInt(p.disc.c,10);
      const sc=x=>isNaN(x)?'':String(Math.min(99,Math.max(20,Math.round(30+x*1.3))));
      p.attrs.nap=sc(d); p.attrs.kom=sc(i); p.attrs.vyn=sc(st); p.attrs.sis=sc(c);
    }
  }
  if(!p.roleId) p.roleId='universal';
  if(!Array.isArray(p.history)) p.history=[];
  ['mbti','metric','values','abilities','skills','track','watch','conflicts','gaps','notes'].forEach(k=>{ if(p[k]===undefined) p[k]=''; });
  if(!p.vTag) p.vTag={values:'',abilities:'',skills:''};
  if(p.fitGood===undefined) p.fitGood=p.strengths||'';
  if(p.fitBad===undefined) p.fitBad=p.weaknesses||'';
  if(!Array.isArray(p.bel)) p.bel = p.believable ? [{area:p.believable, lv:2}] : [];
  return p;
}
people=people.map(migratePerson);
function belMax(p){ if(!p||!Array.isArray(p.bel)||!p.bel.length) return 0; return Math.max.apply(null,p.bel.map(b=>+b.lv||0)); }
function findPersonByName(n){ if(!n)return null; const q=n.trim().toLowerCase(); return people.find(p=>(p.name||'').trim().toLowerCase()===q)||null; }
