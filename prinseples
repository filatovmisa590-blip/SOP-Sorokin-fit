let prinFilter='all', prinEditId=null, statusFilter='all', personEditId=null;
let curMachine={ id:'',title:'',goals:'',problems:'',cause:'',root:'',design:'',actions:'',savedAt:0 };
let edBel=[], edTrack=[], edWatch=[], aiUpdateId=null;
const SEED=[
  {id:'seed1',category:'life',trigger:'Когда что-то пошло не так или больно',rule:'Боль — это сигнал. Останавливаюсь и разбираю её, а не проскакиваю.',why:'Боль + рефлексия = прогресс. Без рефлексии та же боль вернётся.',seed:true,createdAt:Date.now()-5},
  {id:'seed2',category:'decisions',trigger:'Перед важным решением',rule:'Взвешиваю мнения по компетентности — кто реально разбирается в вопросе, а не по статусу или громкости.',why:'Идея-меритократия даёт лучшие решения, чем иерархия или простой консенсус.',seed:true,createdAt:Date.now()-4},
  {id:'seed3',category:'people',trigger:'При найме и расстановке людей',rule:'Сначала правильный человек, потом задача. КТО важнее, чем ЧТО.',why:'Слабого человека не вытащит даже хорошая задача и система.',seed:true,createdAt:Date.now()-3},
  {id:'seed4',category:'company',trigger:'Когда одна и та же ошибка повторяется',rule:'Превращаю проблему в регламент или механизм, а не латаю разово.',why:'Система предотвращает повторение; разовое решение — нет.',seed:true,createdAt:Date.now()-2},
  {id:'seed5',category:'life',trigger:'Когда реальность не такая, как хочется',rule:'Смотрю на реальность как есть, а не как мне удобно. Радикальная правда.',why:'Решения на основе иллюзий — это плохие решения.',seed:true,createdAt:Date.now()-1}
];
const HELP={
  principles:{ title:'Мои принципы', body:`<p>Принципы — это твои <b>правила на повторяющиеся ситуации</b>. Один раз продумал, как правильно поступать — и дальше не решаешь заново каждый раз, а действуешь по своему правилу.</p><p>Формула простая: <b>«когда случается X → делаю Y, потому что Z»</b>. Триггер, само правило, и урок за ним.</p><div class="dalio-note"><div class="dn-l">Почему так</div><p>Не копируй чужие принципы вслепую. Бери их как пример, но выписывай <b>свои</b> — под свой характер, бизнес и ценности. Лучшие принципы рождаются из собственной боли и ошибок.</p></div>` },
  machine:{ title:'Машина', body:`<p>Смотри на себя сверху, как <b>конструктор на свой механизм</b>. Машина состоит из двух вещей: <b>людей и дизайна</b> (процессов). Она выдаёт результаты.</p><p>Сравни результат с целью. Разрыв между ними — это проблема. Твоя работа — не «делать задачи внутри машины», а <b>чинить и улучшать саму машину</b>.</p><div class="dalio-note"><div class="dn-l">Почему так</div><p>Пять шагов — это петля: цели → проблемы → диагноз → дизайн → делай → и снова цели. Каждый круг машина становится сильнее.</p></div>` },
  goals:{ title:'Шаг 1 · Цели', body:`<p>Чётко определи, <b>чего ты хочешь</b>, и расставь приоритеты. Нельзя получить всё — выбирай.</p><p>Не путай цели с задачами: цель — это «куда», задача — это «что сделать по пути».</p>` },
  problems:{ title:'Шаг 2 · Проблемы', body:`<p>Найди, где <b>результат не дотягивает до цели</b>. Это и есть проблемы.</p><p>Не мирись с ними и не сглаживай. Самое опасное — делать вид, что их нет.</p>` },
  diagnose:{ title:'Шаг 3 · Диагноз', body:`<p>Доберись до <b>корневой причины</b>, а не борись с симптомом.</p><p>Ключевая развилка: это поломка в <b>дизайне</b> (процесс настроен неверно) или в <b>человеке</b> (не тот человек / не хватает навыка)? Ответ определяет, что чинить.</p>` },
  design:{ title:'Шаг 4 · Дизайн', body:`<p>Перепроектируй машину так, чтобы <b>обойти проблему</b> — не разово, а на будущее.</p><p>Корень в дизайне — меняй процесс. Корень в человеке — обучение, замена или перестановка.</p>` },
  do:{ title:'Шаг 5 · Делай', body:`<p>Доведи задуманное <b>до результата</b>. План без исполнения ничего не стоит.</p><p>Распиши: кто, что и к какому сроку. Потом вернись и проверь — сработало ли.</p>` },
  people:{ title:'Карточки игроков', body:`<p><b>КТО важнее, чем ЧТО.</b> Сначала правильные люди, потом задачи и стратегия.</p><p>Карточки появились из наблюдения: людей раз за разом ставят на задачи, к которым они не приспособлены. Смысл карточки — <b>чтобы при раздаче задач было видно, кто на что годится</b>, и решение принималось по данным, а не по впечатлению.</p><p>Порядок полей не случайный. Сначала <b>ценности</b>, потом <b>способности</b>, потом <b>навыки</b> — именно в этом порядке, потому что навыки добираются обучением, а первые два практически нет.</p><div class="dalio-note"><div class="dn-l">Почему так</div><p>«Люди обычно меняются не так уж сильно». Не строй план на том, что человек станет другим — строй на том, какой он есть, и ставь его туда, где его сильные стороны работают, а слабые не мешают.</p></div>` },
  bel:{ title:'Доверие по компетентности', body:`<p>Это ответ на вопрос: <b>по каким темам мнению этого человека можно верить</b>, а по каким — нет.</p><p>Доверие зарабатывается результатами, а не должностью и не стажем. Человек может быть эталоном в продажах и нулём в аналитике — и это нормально, если записано.</p><p>Уровни: <b>нет данных → низкое → ниже среднего → среднее → высокое → эталон</b>. «Нет данных» — честный статус для новичка, он не оскорбителен.</p><div class="dalio-note"><div class="dn-l">Зачем это здесь</div><p>Во вкладке «Решение» вес голоса подставляется именно отсюда. Пока у человека нет результатов, его мнение не весит — и спор выигрывает не громкость, а доказанная компетентность.</p></div>` },
  decision:{ title:'Решение по компетентности', body:`<p>Когда решение спорное, не считай голоса поровну. Взвесь их по <b>доверию</b> — насколько каждый участник реально разбирается именно в этом вопросе.</p><p>Собери позиции, поставь вес 1–5 (или он подставится из карточки), и система покажет, какой вариант сильнее по компетентности. Часто он отличается от мнения большинства — ради этого момента инструмент и нужен.</p><div class="dalio-note"><div class="dn-l">Почему так</div><p>Идея-меритократия = радикальная правда + радикальная прозрачность + решения, взвешенные по компетентности. Не диктатура и не «один человек — один голос».</p></div>` }
};
