function delPerson(id){
  const i=people.findIndex(x=>x.id===id); if(i<0) return;
  const p=people[i];
  trash.unshift(Object.assign({},p,{_delAt:Date.now()}));
  if(trash.length>40) trash=trash.slice(0,40);
  people.splice(i,1);
  saveArr(K_PEOPLE,people); saveArr(K_TRASH,trash);
  renderPeople(); renderVoters&&renderVoters();
  undoToast('«'+(p.name||'Карточка')+'» убрана в корзину','Вернуть',function(){ restorePerson(p.id); });
}
function restorePerson(id){
  const i=trash.findIndex(x=>x.id===id); if(i<0){ toast('В корзине не найдено'); return; }
  const p=trash.splice(i,1)[0]; delete p._delAt;
  if(people.some(x=>x.id===p.id)) p.id=uid();
  people.unshift(migratePerson(p));
  saveArr(K_PEOPLE,people); saveArr(K_TRASH,trash);
