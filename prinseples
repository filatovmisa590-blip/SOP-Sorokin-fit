const LS={ get(k){ try{ return localStorage.getItem(k); }catch(e){ return null; } }, set(k,v){ try{ localStorage.setItem(k,v); return true; }catch(e){ return false; } } };
const K_TRASH='dalio_trash_v1';
const K_PRIN='dalio_principles_v1', K_PEOPLE='dalio_people_v1', K_MACH='dalio_machines_v1', K_MACH_CUR='dalio_machine_cur_v1', K_SEED='dalio_seeded_v1', K_DEC='dalio_decisions_v1', K_DEC_CUR='dalio_decision_cur_v1';
